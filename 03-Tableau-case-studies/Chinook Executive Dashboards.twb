      <column caption='First Purchase Date' datatype='datetime' name='[Calculation_0229298693087235]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [CustomerId] : MIN([InvoiceDate]) }' />
      </column>
      <column caption='Activity Quarter' datatype='datetime' name='[Calculation_0229298694787076]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;quarter&apos;, [InvoiceDate])' />
      </column>
      <column caption='Cohort Quarter' datatype='string' name='[Calculation_0229298694942725]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([Calculation_0229298693087235])) + &quot;-Q&quot; + STR(DATEPART(&apos;quarter&apos;, [Calculation_0229298693087235]))' />
      </column>
      <column caption='Cohort Quarter (Date)' datatype='datetime' name='[Calculation_0229298695049222]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;quarter&apos;, [Calculation_0229298693087235])' />
      </column>
      <column caption='Quarters Since First Purchase' datatype='integer' name='[Calculation_0229298695147527]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;quarter&apos;, [Calculation_0229298695049222], [Calculation_0229298694787076])' />
      </column>
      <column caption='Revenue per Customer' datatype='real' name='[Calculation_0229298695217160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([InvoiceTotal]) / COUNTD([CustomerId])' />
      </column>
      <column caption='Revenue per Catalog Track' datatype='real' name='[Calculation_0229298705756169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([LineTotal]) / MAX([CatalogTrackCount])' />
      </column>
