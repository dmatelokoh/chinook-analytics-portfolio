            <column-instance column='[GenreName]' derivation='None' name='[none:GenreName:nk]' pivot='key' type='nominal' />
            <column-instance column='[InvoiceTotal]' derivation='Sum' name='[pcto:sum:InvoiceTotal:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
